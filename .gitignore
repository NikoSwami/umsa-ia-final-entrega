api.log
cloudflared.log

*.tmp
*.json.tmp
*.json.bak
*.bak
Thumbs.db
.DS_Store

# Configuracion local con secretos (GACETA_ADMIN_TOKEN, credenciales de MOF).
# El ejemplo SI se versiona: .env.example
.env
.env.local
.env.*.local

!.env.example
!gaceta_rag/mejoras/*.pyd
!*.pyd
