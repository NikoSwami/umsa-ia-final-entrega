# Configuración de la Gaceta IA. Copiar a .env y completar.
#
#   cp .env.example .env
#
# El .env está gitignoreado porque lleva el token. Este ejemplo sí se versiona.
# Precedencia: variables ya exportadas en el entorno > .env > valores por
# defecto del código. En escritorio se puede seguir usando
# iniciar_web_react.bat sin .env; todo funciona igual.


# ── Conexión con MOF (organigrama) ───────────────────────────────────
# La Gaceta le PREGUNTA a MOF qué cambió, sola. Con estas tres variables no
# hay que encender ni cargar nada: al arrancar llena su base del organigrama y
# la mantiene al día. Sin MOF_URL no consulta nada y el chat funciona igual.
#
# Ojo con el nombre: dentro de un contenedor, "localhost" es el contenedor
# mismo. Si los dos corren en el mismo Docker Compose usá el nombre del
# servicio (http://backend:3000); si están sueltos en la misma VM, 127.0.0.1.
MOF_URL=http://127.0.0.1:3000
MOF_TIMEOUT=8

# Cuenta de la Gaceta en MOF, para leer su auditoría (GET /versiones pide
# sesión). Tiene que ser una cuenta PROPIA con rol USER ("Usuario de
# consulta"), nunca la de administrador: queda escrita en este archivo.
# Sin ella la Gaceta igual se mantiene al día, pero los cambios en funciones
# tardan hasta la reconciliación profunda. GET /api/ingesta/mof lo avisa.
MOF_USUARIO=
MOF_PASSWORD=

# Frecuencias. SIN la variable rige el valor por defecto (el de al lado), que
# es lo que hace que no haya que acordarse de encender nada. Un 0 apaga.
#
#   MOF_CONSULTAR_CADA_S      pregunta a la auditoría            (30)
#   MOF_RECONCILIAR_CADA_S    compara todo contra el listado    (900)
#   MOF_RECONCILIAR_PROFUNDA  cada cuántas de esas, profunda     (12)
#
# La reconciliación es la red para lo que la auditoría no ve: los cargos (MOF
# no los audita), cambios hechos con SQL a mano y vectores perdidos si el
# proceso murió antes de bajar el índice a disco.
MOF_CONSULTAR_CADA_S=
MOF_RECONCILIAR_CADA_S=
MOF_RECONCILIAR_PROFUNDA=

# Dónde vive la réplica estructurada del organigrama (unidades, funciones y
# cargos), la que permite CONTAR y LISTAR exacto. Vacío = junto a la base de
# chunks, que es lo normal. Se crea y se llena sola.
MOF_REPLICA=

# El de ADMINISTRADOR protege apagar el servidor y los interruptores.
# OBLIGATORIO en servidor. Generarlo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GACETA_ADMIN_TOKEN=

# Puerta de ENTRADA de eventos (POST /api/ingesta/mof), por si algún
# despliegue quiere que MOF empuje. Con la Gaceta preguntando NO hace falta:
# vacío, esa puerta sólo acepta el token de administrador, que no sale de
# aquí. Ningún secreto guardado fuera de la Gaceta la abre.
GACETA_INGESTA_TOKEN=

# Cada cuántos eventos (o segundos) se baja el índice FAISS a disco. Los
# cambios se ven en el chat de inmediato; esto es sólo la persistencia.
MOF_FLUSH_CADA=25
MOF_FLUSH_SEGUNDOS=300

# Válvula de seguridad de las bajas. Una lista vacía de MOF siempre se rechaza,
# sin importar estos valores.
MOF_UMBRAL_BAJAS=0.25
MOF_MINIMO_BAJAS=5


# ── Motor de lenguaje ───────────────────────────────────────────────
# Vacío = Qwen2.5-7B local (GPU). "api" = un proveedor con el dialecto
# OpenAI (motor_api.py); el resto del pipeline no cambia.
# GACETA_BACKEND=api
# GACETA_API_PROVEEDOR=gemini          # gemini | groq | openrouter | cerebras
# GACETA_API_MODELO=                   # vacío = el default del proveedor
# La clave va con el nombre del proveedor (una sola alcanza):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
#
# Los modelos que razonan (Gemini) gastan los tokens de pensar del MISMO
# max_tokens que la respuesta visible: el motor pide lo que pediría a Qwen y
# esto lo multiplica (Gemini trae 4). Acepta decimales.
# GACETA_API_FACTOR_TOKENS=
# GACETA_API_RAZONAMIENTO=             # reasoning_effort: low | medium | high
# GACETA_API_TOPE_TOKENS=              # techo de salida del modelo
#
# Herramientas de solo lectura sobre la réplica del organigrama (contar,
# hijas, rama, funciones, buscar), sólo por API y sólo en las preguntas por
# UNA unidad, donde la respuesta se verifica cifra por cifra. Apagado.
GACETA_API_HERRAMIENTAS=0


# ── Carga manual de documentos (/carga) ──────────────────────────────
# Token de la página de carga y de /api/carga (header X-Admin-Token). Sirve
# SOLO para cargar: no apaga el servidor ni toca los interruptores. También
# vale GACETA_ADMIN_TOKEN. Sin ninguno, la carga responde 503 (en Docker el
# arranque genera uno y lo muestra en el log).
GACETA_CARGA_TOKEN=

# Dónde está el OCR (servicio_ocr/). En Docker lo pone el
# compose (http://ocr:8001). Sin OCR, los PDF con texto se cargan igual; los
# escaneados y las imágenes no.
# OCR_URL=http://127.0.0.1:8001
# OCR_LOCAL=1          # o el OCR dentro de este proceso (con sus dependencias)
# OCR_MOTOR=liviano    # liviano (ONNX, segundos por página) | vl (PaddleOCR-VL)
# OCR_DPI=auto         # liviano: resolución del propio escaneo, o un número
# CARGA_MAX_MB=100     # tamaño máximo de un archivo subido


# ── Docker (docker-compose.yml) ──────────────────────────────────────
# Puerto de esta PC donde queda la app (solo 127.0.0.1).
# GACETA_PUERTO=8000
# MOF visto desde el contenedor ("127.0.0.1" ahí es el contenedor mismo).
# Vacío = sin MOF en vivo. Si MOF corre en esta PC:
# DOCKER_MOF_URL=http://host.docker.internal:3000
# Versión del pipeline de PaddleOCR-VL (solo OCR_MOTOR=vl): v1 | v1.5 | v1.6
# OCR_VERSION=v1.5


# ── Paperless + MCP (docker-compose.paperless.yml) ───────────────────
# Puerta de entrada de documentos. Opcional: sin ese archivo de compose nada de
# esto se usa. Generar cada secreto, uno distinto, con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PAPERLESS_SECRET_KEY=
# PAPERLESS_ADMIN_USER=admin
# PAPERLESS_ADMIN_PASSWORD=
# GACETA_PAPERLESS_TOKEN=              # lo manda el webhook; abre solo el aviso
#
# Solo los documentos con esta etiqueta pasan a la Gaceta, y quedan en /carga
# hasta que alguien los confirma. Con PAPERLESS_REVISAR=false se indexan solos.
# PAPERLESS_ETIQUETA=gaceta
# PAPERLESS_REVISAR=true
#
# Cada cuanto se compara con Paperless, la red para lo que el webhook no ve (bajas
# incluidas). 0 apaga. Mas de PAPERLESS_MINIMO_BAJAS bajas que ademas superen
# PAPERLESS_UMBRAL_BAJAS del total quedan retenidas hasta confirmarlas con
# POST /api/paperless/reconciliar {"confirmar": true}.
# PAPERLESS_RECONCILIAR_CADA_S=300
# PAPERLESS_UMBRAL_BAJAS=0.25
# PAPERLESS_MINIMO_BAJAS=5
#
# Los llena "python docker/preparar_paperless.py", no a mano: el token con que
# el MCP habla con Paperless y el de solo lectura de la Gaceta.
# PAPERLESS_MCP_API_KEY=
# GACETA_PAPERLESS_API_KEY=
#
# Puertos de esta PC (solo 127.0.0.1). El 3000 es de MOF y el 8000 de la Gaceta.
# PAPERLESS_PUERTO=8002
# PAPERLESS_MCP_PUERTO=3100
# Carpeta de esta PC donde se dejan los archivos para subir por el MCP.
# PAPERLESS_ENTRADA=./entrada


# ── Motor RAG ────────────────────────────────────────────────────────
# Valores por defecto del código; descomentar sólo para cambiarlos.
# TOP_K_FAISS=30
# TOP_K_FTS=20
# TOP_K_FINAL=10
# USAR_RERANKER=1

# Canales de recuperación. Poner en 0 desactiva el canal (contrato seguro).
# USAR_GRAFO_CITAS=1
# USAR_INDICE_PERSONAS=1
# USAR_INDICE_TEMAS=1

# Interruptores de la interfaz.
# LISTAS_HABILITADAS=1
# MEMORIA_HABILITADA=1

# HuggingFace: XET provoca "Cannot send a request, as the client has been
# closed" en este venv. OFFLINE evita depender de la red si el modelo ya está
# cacheado — recomendable en el servidor.
HF_HUB_DISABLE_XET=1
# HF_HUB_OFFLINE=1
